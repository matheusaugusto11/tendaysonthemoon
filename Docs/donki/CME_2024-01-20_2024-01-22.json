ment eruption CME.","minorHalfWidth":null,"speedMeasuredAtHeight":9.0,"tilt":null,"submissionTime":"2024-01-20T21:15Z","link":"https://ccmc.gsfc.nasa.gov/DONKI/view/CMEAnalysis/28661/-1","enlilList":[{"modelCompletionTime":"2024-01-20T21:17Z","au":2.0,"estimatedShockArrivalTime":null,"isEarthGB":false,"isEarthMinorImpact":false,"rmin_re":null,"kp_18":null,"kp_90":null,"kp_135":null,"kp_180":null,"estimatedDuration":null,"link":"https://ccmc.gsfc.nasa.gov/DONKI/view/WSA-ENLIL/28662/-1","impactList":[],"cmeIDs":["2024-01-20T09:36:00-CME-001"]}]}],"linkedEvents":null,"sentNotifications":null,"link":"https://ccmc.gsfc.nasa.gov/DONKI/view/CME/28660/-1","submissionTime":"2024-01-20T21:13Z","versionId":1},{"activityID":"2024-01-20T20:00:00-CME-001","catalog":"M2M_CATALOG","startTime":"2024-01-20T20:00Z","instruments":[{"displayName":"SOHO: LASCO/C2"},{"displayName":"SOHO: LASCO/C3"},{"displayName":"STEREO A: SECCHI/COR2"}],"sourceLocation":"","activeRegionNum":null,"note":"Semi-faint CME seen to the NW in SOHO LASCO C2, C3, and after a data gap in STEREO A COR2 imagery. The source of this CME is a far sided filament eruption starting around 2024-01-20T19:36Z as seen in GOES SUVI 304. Moving/opening field lines are visible in SDO/AIA 171 and GOES SUVI 284. The filament has a \"shredded\" appearance to it, possibly creating multiple fronts within one feature.","cmeAnalyses":[{"isMostAccurate":true,"levelOfData":0,"time21_5":"2024-01-21T05:09Z","latitude":25.0,"longitude":null,"halfAngle":42.0,"speed":413.0,"type":"S","featureCode":"LE","imageType":"running difference","measurementTechnique":"Plane-of-sky","note":"Plane-of-sky measurement using SOHO coronagraph imagery. Longitudes are likely greater than 90 degrees based on partial visibility of source.","minorHalfWidth":null,"speedMeasuredAtHeight":13.4,"tilt":null,"submissionTime":"2024-01-21T22:13Z","link":"https://ccmc.gsfc.nasa.gov/DONKI/view/CMEAnalysis/28676/-1","enlilList":[]}],"linkedEvents":null,"sentNotifications":